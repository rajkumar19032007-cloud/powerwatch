# ==============================================================================
# CampusOS Backend — Environment Variables Template
# Copy this file to .env and configure your local settings
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for CORS)
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusos_db

# JWT Security Configuration
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=2h
